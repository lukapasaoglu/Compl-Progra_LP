<Window x:Class="PrograMail_26_27.CommunicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Communication Réseau" Height="450" Width="600">
    <DockPanel Margin="10">
        <Menu DockPanel.Dock="Top" Margin="0,0,0,10">
            <MenuItem Header="Communication">
                <MenuItem Header="Listener/client">
                    <MenuItem Header="Ecouter" Click="MenuTcpEcouter_Click"/>
                    <MenuItem Header="Connecter" Click="MenuTcpConnecter_Click"/>
                </MenuItem>
                <MenuItem Header="UDP">
                    <MenuItem Header="Ecouter" Click="MenuUdpEcouter_Click"/>
                    <MenuItem Header="Connecter" Click="MenuUdpConnecter_Click"/>
                </MenuItem>
                <MenuItem Header="Socket">
                    <MenuItem Header="Ecouter" Click="MenuSocketEcouter_Click"/>
                    <MenuItem Header="Connecter" Click="MenuSocketConnecter_Click"/>
                    <MenuItem Header="Déconnecter" Click="MenuSocketDeconnecter_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Utilitaire">
                <MenuItem Header="Vérifier" Click="MenuVerifier_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Serveur :"/>
            <TextBox x:Name="txtServeur" Grid.Row="0" Grid.Column="1" Margin="3"/>

            <Label Grid.Row="1" Grid.Column="0" Content="IP :"/>
            <TextBox x:Name="txtIp" Grid.Row="1" Grid.Column="1" Margin="3" IsReadOnly="True" Background="#EEE"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Message :"/>
            <TextBox x:Name="txtMessage" Grid.Row="2" Grid.Column="1" Margin="3"/>
            <Button x:Name="btnEnvoyer" Grid.Row="2" Grid.Column="2" Content="Envoyer" Margin="3" Click="BtnEnvoyer_Click"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Echanges :"/>
            <TextBox x:Name="txtEchanges" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="3" 
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>