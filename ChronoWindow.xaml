<Window x:Class="PrograMail_26_27.ChronoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chronomètre Analogique" Height="480" Width="380"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Chronomètre" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Stroke="Black" StrokeThickness="4" Fill="White"/>

            <Ellipse Width="12" Height="12" Fill="DarkRed" Panel.ZIndex="3"/>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="220" Height="220" Panel.ZIndex="2">
                <Grid.LayoutTransform>
                    <RotateTransform Angle="{Binding AngleAiguille}"/>
                </Grid.LayoutTransform>
                <Rectangle Width="3" Height="90" Fill="DarkRed" VerticalAlignment="Top" Margin="0,20,0,0"/>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding TempsTexte}" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,15,0,15"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Démarrer" Width="85" Height="32" Margin="5" Command="{Binding DemarrerCommand}"/>
            <Button Content="Arrêter" Width="85" Height="32" Margin="5" Command="{Binding ArreterCommand}"/>
            <Button Content="Réinitialiser" Width="85" Height="32" Margin="5" Command="{Binding ReinitialiserCommand}"/>
        </StackPanel>
    </Grid>
</Window>