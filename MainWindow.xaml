<Window x:Class="PrograMail_26_27.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrograMail_26_27"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="18*"/>
        </Grid.RowDefinitions>
        <Label Content="Votre e-mail :" HorizontalAlignment="Left" Margin="69,27,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.684,0.813"/>
        <Label Content="Mot de passe d'app :" HorizontalAlignment="Left" Margin="69,81,0,0" VerticalAlignment="Top"/>
        <Label Content="Objet :" HorizontalAlignment="Left" Margin="69,17,0,0" VerticalAlignment="Top" Grid.Row="1"/>
        <Label Content="Message :" HorizontalAlignment="Left" Margin="69,82,0,0" VerticalAlignment="Top" Grid.Row="1"/>
        <Label Content="Destinataire :" HorizontalAlignment="Left" Margin="69,135,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.554,0.197" Cursor=""/>
        <TextBox x:Name="TxtExpediteur" HorizontalAlignment="Left" Margin="72,58,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="161" Height="23"/>
        <PasswordBox x:Name="TxtPassword" HorizontalAlignment="Left" Margin="69,112,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="TxtDestinataire" HorizontalAlignment="Left" Margin="69,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.RowSpan="2"/>
        <TextBox x:Name="TxtSujet" HorizontalAlignment="Left" Margin="69,48,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.Row="1"/>
        <TextBox x:Name="TxtMessage" HorizontalAlignment="Left" Margin="69,113,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210" Height="55" Grid.Row="1"/>
        <Button x:Name="BtnEnvoyer" Content="Envoyer le mail" HorizontalAlignment="Left" Margin="69,173,0,0" VerticalAlignment="Top" Height="33" Width="137" Click="BtnEnvoyer_Click" Grid.Row="1"/>

    </Grid>
</Window>
